{
  "name": "fir-web3",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "install:all": "npm --prefix contracts install && npm --prefix web install",
    "genkey": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "chain": "npm --prefix contracts run node",
    "test:contracts": "npm --prefix contracts test",
    "deploy": "npm --prefix contracts run deploy",
    "deploy:local": "npm --prefix contracts run deploy:local",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "audit": "npm --prefix web run audit"
  }
}
